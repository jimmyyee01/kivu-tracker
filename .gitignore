# runtime data (logs, drop-in files) — never commit
data/*.log
data/*.err
data/*.json
data/*.txt
data/*.out
# pieces of an in-flight login page media upload
data/hero-upload/

# the sign-in page picture/video a super admin uploads (server-side file)
public/media/login/

# uploaded files (if you add uploads later)
uploads/

# Android build outputs and local signing configuration
/android/.gradle/
/android/app/build/
/android/local.properties
/android/keystore.properties
/android/*.jks
/public/download/*.apk

# editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.bak
.idea/
.vscode/
.kilo/

# build logs
android/build.log
