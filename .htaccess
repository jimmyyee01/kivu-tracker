# =====================================================================
#  KIVU Tracker — Apache routing (PHP + MySQL + IPS tracker)
#  Point a VirtualHost / DocumentRoot at this folder, or serve it from
#  XAMPP htdocs and open /kivu-tracker/.
# =====================================================================
RewriteEngine On

# JSON API -> php/api.php?r=/path  (identical paths to the dev router)
RewriteRule ^api/?$ php/api.php?r=/ [QSA,L]
RewriteRule ^api/(.*)$ php/api.php?r=/$1 [QSA,L]

# Pretty pages
RewriteRule ^login/?$   public/login.html   [L]
RewriteRule ^app/?$     public/app.html     [L]
RewriteRule ^admin/?$   public/admin.html   [L]
RewriteRule ^reports/?$ public/reports.html [L]
RewriteRule ^super/?$   public/super.html   [L]
RewriteRule ^track/([A-Za-z0-9_\-]{3,64})/?$ public/track.html [L]
RewriteRule ^track/?$   public/track.html   [L]
RewriteRule ^register/?$ public/register.html [L]
RewriteRule ^signup/?$   public/register.html [L]
RewriteRule ^billing/?$  public/billing.html  [L]
RewriteRule ^reseller/?$ public/reseller.html [L]
RewriteRule ^download/?$ public/download.html [L]
RewriteRule ^manual/?$   public/manual.html   [L]
RewriteRule ^modules/?$  public/modules.html  [L]
# The entry point is the sign-in page (/ -> php/cms.php below redirects there);
# the marketing site stays online at /welcome and /index.html
RewriteRule ^welcome/?$   public/index.html   [L]
RewriteRule ^index\.html$ public/index.html   [L]

# Business-module consoles (systems live on subdomains; these are local/dev fallbacks)
RewriteRule ^telematics/?$      public/app.html      [L]
RewriteRule ^m/agriculture/?$   public/agri.html     [L]
RewriteRule ^m/health/?$        public/health.html   [L]
RewriteRule ^m/([a-z0-9\-]{2,64})/?$ php/module.php?module=$1&console=1 [L,QSA]

# Content manager (super admin only, refused for the mobile app) + public
# CMS pages, rendered server-side by php/cms.php
RewriteRule ^cms/?$      php/cms-manager.php  [L]
RewriteRule ^p/([a-z0-9\-]{1,64})/([a-z0-9\-]{1,64})/?$ php/cms.php?account=$1&slug=$2 [L,QSA]
RewriteRule ^p/([a-z0-9\-]{1,64})/?$ php/cms.php?slug=$1 [L,QSA]
RewriteRule ^download/(.+)$ public/download/$1 [L]
RewriteRule ^pay/?$      public/pay.html      [L]
RewriteRule ^pay/([A-Za-z0-9_\-]{3,64})/?$ public/pay.html [L]

# Module dynamic pages (published, SSR) — must come before the generic module rule
RewriteRule ^([a-z0-9\-]{2,64})/p/([a-z0-9\-]{1,64})/?$ php/module.php?module=$1&slug=$2 [L,QSA]
# Module landing pages (telematics keeps legacy CMS/static behavior at /)
RewriteRule ^(agriculture|health)/?$ php/module.php?module=$1 [L,QSA]

RewriteRule ^$          php/cms.php         [L]

# Static assets live in public/
RewriteRule ^(css|js|img)/(.*)$ public/$1/$2 [L]

# Optional pretty permanent links for public unit sharing
RewriteRule ^api/track/([a-f0-9]{32})$ php/api.php?r=/track/$1 [QSA,L]

# Keep PHP internals out of direct browser access (api.php/module.php/install.php allowed)
<FilesMatch "^(config|engine|ingest|notify|trips|reports|ips|demo|routes_.*|tracker|modules|cms|cms-manager)\.php$">
    Require all denied
</FilesMatch>

# Development helpers and runtime data are not part of the served site.
# (php/ is already covered by the FilesMatch rule above, so api.php keeps working.)
RewriteRule ^tools/ - [F,L]
RewriteRule ^data/ - [F,L]
