# Normalise line endings in the repository so the Linux VPS never receives
# CRLF shell scripts (a CRLF .sh fails with "bad interpreter").
* text=auto

*.sh    text eol=lf
*.php   text eol=lf
*.py    text eol=lf
*.service text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.jpg   binary
*.ico   binary
*.apk   binary
*.tar.gz binary
